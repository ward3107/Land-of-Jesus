# Expo/Metro's bundler uses flat module resolution and does not understand
# pnpm's default isolated (symlinked) node_modules. The Expo-recommended setup
# for a pnpm monorepo is the hoisted node-linker, which lays out a flat
# node_modules like npm/yarn so Metro can resolve transitive dependencies.
auto-install-peers=true
strict-peer-dependencies=false
node-linker=hoisted
