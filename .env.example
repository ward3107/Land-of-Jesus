# CommunityDirect — environment variable template.
# Copy to .env.local (never commit real values). See docs/SECURITY.md.

# ---- Supabase (public / client-safe) ----
# Safe to expose to browsers and the mobile app.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key

# ---- Supabase (server-only / SECRET) ----
# NEVER ship this to a client bundle. Server / worker only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-server-only
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ---- Push (Expo) ----
# Optional Expo access token used by the server-side delivery worker.
EXPO_ACCESS_TOKEN=

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_DEEP_LINK_SCHEME=communitydirect
