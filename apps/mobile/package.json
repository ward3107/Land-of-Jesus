{
  "name": "@communitydirect/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "config": "expo config --type public",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"{app,lib}/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "clean": "rm -rf .expo dist .turbo coverage *.tsbuildinfo"
  },
  "dependencies": {
    "@communitydirect/core": "workspace:*",
    "@communitydirect/i18n": "workspace:*",
    "@supabase/supabase-js": "2.46.1",
    "expo": "~52.0.11",
    "expo-constants": "~17.0.3",
    "expo-linking": "~7.0.3",
    "expo-notifications": "~0.29.9",
    "expo-router": "~4.0.9",
    "expo-status-bar": "~2.0.0",
    "query-string": "7.1.3",
    "react": "18.3.1",
    "react-native": "0.76.3",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.1.0"
  },
  "devDependencies": {
    "@communitydirect/eslint-config": "workspace:*",
    "@types/react": "~18.3.12",
    "eslint": "9.15.0",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
