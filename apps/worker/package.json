{
  "name": "@communitydirect/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run",
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "clean": "rm -rf dist .turbo coverage *.tsbuildinfo"
  },
  "dependencies": {
    "@communitydirect/core": "workspace:*",
    "@communitydirect/push": "workspace:*",
    "@supabase/supabase-js": "2.46.1"
  },
  "devDependencies": {
    "@communitydirect/eslint-config": "workspace:*",
    "@types/node": "22.10.1",
    "eslint": "9.15.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
